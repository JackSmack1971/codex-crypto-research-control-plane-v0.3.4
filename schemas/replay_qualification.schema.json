{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["qualification_mode", "status", "fixture", "fixture_digests", "control_plane_source", "python_runtime", "stages", "artifact_digests", "bundle_identity", "bundle_digest", "source_run_id", "source_attempt_id", "source_artifact_digest", "replay_artifact_digest", "artifact_comparisons", "live_provider_qualified", "live_daily_run_pass", "provider_access_in_replay", "provider_authentication_in_replay", "provider_entitlement_in_replay", "replay_provider_compliance", "live_provider_requests_in_replay", "provider_checks", "limitations"],
  "allOf": [
    {"if": {"properties": {"qualification_mode": {"const": "OFFLINE_REPLAY"}}}, "then": {"properties": {"status": {"enum": ["PASS", "BLOCKED"]}, "bundle_identity": {"type": "null"}, "bundle_digest": {"type": "null"}}}},
    {"if": {"properties": {"qualification_mode": {"const": "LIVE_CAPTURE_REPLAY"}}}, "then": {"properties": {"status": {"enum": ["LIVE_CAPTURE_REPLAY_MATCH", "LIVE_CAPTURE_REPLAY_MISMATCH", "BLOCKED"]}, "bundle_identity": {"type": "string"}, "bundle_digest": {"type": "string"}}}}
  ],
  "properties": {
    "qualification_mode": {"enum": ["OFFLINE_REPLAY", "LIVE_CAPTURE_REPLAY"]},
    "status": {"enum": ["PASS", "LIVE_CAPTURE_REPLAY_MATCH", "LIVE_CAPTURE_REPLAY_MISMATCH", "BLOCKED"]},
    "fixture": {"type": "object"},
    "fixture_digests": {"type": "object"},
    "control_plane_source": {"type": "object"},
    "python_runtime": {"type": "object"},
    "stages": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "artifact_digests": {"type": "object"},
    "bundle_identity": {"type": ["string", "null"]}, "bundle_digest": {"type": ["string", "null"]},
    "source_run_id": {"type": ["string", "null"]}, "source_attempt_id": {"type": ["string", "null"]},
    "source_artifact_digest": {"type": ["string", "null"]}, "replay_artifact_digest": {"type": ["string", "null"]},
    "artifact_comparisons": {"type": "object", "additionalProperties": {"enum": ["MATCH", "MISMATCH"]}},
    "live_provider_qualified": {"const": false},
    "live_daily_run_pass": {"const": false},
    "provider_access_in_replay": {"const": "NOT_TESTED"}, "provider_authentication_in_replay": {"const": "NOT_TESTED"},
    "provider_entitlement_in_replay": {"const": "NOT_TESTED"}, "replay_provider_compliance": {"const": "NOT_TESTED"},
    "live_provider_requests_in_replay": {"const": 0},
    "provider_checks": {
      "type": "object", "additionalProperties": false,
      "required": ["massive_mcp_visibility", "authentication", "entitlement", "effective_capability_probe", "live_request_ledger", "live_acquisition"],
      "properties": {
        "massive_mcp_visibility": {"const": "NOT_TESTED"}, "authentication": {"const": "NOT_TESTED"},
        "entitlement": {"const": "NOT_TESTED"}, "effective_capability_probe": {"const": "NOT_TESTED"},
        "live_request_ledger": {"const": "NOT_TESTED"}, "live_acquisition": {"const": "NOT_TESTED"}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}

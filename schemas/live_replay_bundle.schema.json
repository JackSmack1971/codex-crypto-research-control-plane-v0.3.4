{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["bundle_schema_version", "bundle_id", "bundle_digest", "source_provenance", "run_id", "attempt_id", "research_cutoff", "created_at", "source_control_plane", "acquisition", "source_live_request_compliance", "replay_provider_compliance", "datasets", "controls", "expected_pipeline_digests", "source_pipeline_result_digest", "source_runtime", "inventory"],
  "properties": {
    "bundle_schema_version": {"const": 1},
    "bundle_id": {"type": "string", "minLength": 1},
    "bundle_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_provenance": {"const": "LIVE_CAPTURE"},
    "run_id": {"type": "string", "minLength": 1}, "attempt_id": {"type": "string", "minLength": 1},
    "research_cutoff": {"type": "string", "format": "date-time"}, "created_at": {"type": "string", "format": "date-time"},
    "source_control_plane": {"type": "object"},
    "acquisition": {"type": "object", "required": ["acquisition_id", "manifest_digest", "manifest_content_digest", "status"], "properties": {"acquisition_id": {"type": "string"}, "manifest_digest": {"type": "string"}, "manifest_content_digest": {"type": "string"}, "status": {"enum": ["COMPLETE", "DEGRADED"]}}, "additionalProperties": false},
    "source_live_request_compliance": {"type": "object", "required": ["status", "ledger_identity", "ledger_digest"], "properties": {"status": {"enum": ["COMPLIANT", "NOT_RECORDED"]}, "ledger_identity": {"type": ["string", "null"]}, "ledger_digest": {"type": ["string", "null"]}}, "additionalProperties": false},
    "replay_provider_compliance": {"const": "NOT_TESTED"},
    "datasets": {"type": "array", "minItems": 3, "items": {"type": "object", "additionalProperties": false, "required": ["role", "data_path", "metadata_path", "data_digest", "metadata_digest", "row_count"], "properties": {"role": {"enum": ["crypto_universe", "crypto_cutoff", "crypto_history", "fx_history", "stock_history", "index_history"]}, "data_path": {"type": "string"}, "metadata_path": {"type": "string"}, "data_digest": {"type": "string"}, "metadata_digest": {"type": "string"}, "row_count": {"type": "integer", "minimum": 0}}}},
    "controls": {"type": "object", "additionalProperties": false, "required": ["data_quality", "capability_evaluation", "model_config"], "properties": {"data_quality": {"type": "string"}, "capability_evaluation": {"type": "string"}, "model_config": {"type": "string"}}},
    "expected_pipeline_digests": {"type": "object", "minProperties": 1}, "source_pipeline_result_digest": {"type": "string"},
    "source_runtime": {"type": "object"},
    "inventory": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "digest", "size"], "properties": {"path": {"type": "string", "pattern": "^[^\\\\].*"}, "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "size": {"type": "integer", "minimum": 0}}}}
  }
}
